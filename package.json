{
  "name": "river-room",
  "version": "0.1.0",
  "private": true,
  "description": "River Room: a poker trainer for a home game, with dealer's-choice split variants, bots and a coach.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node tools/ui/smoke.mjs",
    "golden:record": "node tools/golden/record.mjs",
    "parity": "tsx tools/sim/parity.ts",
    "review:eval": "tsx tools/review/eval.ts",
    "review:eval-set": "tsx tools/review/make-eval-set.ts",
    "server:build": "esbuild server/src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/main.js",
    "server:start": "node server/dist/main.js",
    "server:dev": "tsx server/src/main.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node tools/db/migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  }
}
